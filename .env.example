# Database
DATABASE_URL=sqlite:///./ce_guests.db

# JWT
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=5
REFRESH_TOKEN_EXPIRE_HOURS=1
TOKEN_CLEANUP_INTERVAL_SECONDS=300

# CORS
CORS_ORIGINS=http://localhost:5173

# Timezone
TIMEZONE=Europe/Moscow

# Server
HOST=127.0.0.1
PORT=8000

# External pass API (fallback, if pass_integration is not set in DB)
PASS_API_BASE_URL=
PASS_API_LOGIN=
PASS_API_PASSWORD=
PASS_API_OBJECT=
PASS_API_CORPA=
PASS_API_ORDER_TYPE=1
PASS_API_BIRTHDAY=1917-11-07
PASS_API_BUILDIN=
PASS_API_FLOOR=
PASS_API_OFFICE=
PASS_API_CONTACT_EMAIL=
PASS_API_CONTACT_PHONE=
PASS_API_POLL_DELAYS=1,2,3,5,8
PASS_API_TIMEOUT_SECONDS=15
PASS_API_VERIFY_SSL=false
